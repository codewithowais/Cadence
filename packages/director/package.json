      "default": "./src/sound-synth.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cadence/core": "*",
    "@cadence/understanding": "*",
    "zod": "4.5.4"
  }
}
