{
  "name": "@cadence/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant Postgres data layer for Cadence: schema migrations, a pooled client, and typed, tenant-scoped, parameterized repositories over orgs/users/projects/media/edit-docs (versioned, append-only).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./queries": {
      "types": "./src/queries.ts",
      "default": "./src/queries.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@cadence/core": "*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
