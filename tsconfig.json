{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@cadence/core": ["packages/core/src/index.ts"],
      "@cadence/render-node": ["packages/render-node/src/index.ts"],
      "@cadence/understanding": ["packages/understanding/src/index.ts"],
      "@cadence/director": ["packages/director/src/index.ts"],
      "@cadence/enhance": ["packages/enhance/src/index.ts"],
      "@cadence/render-ffmpeg": ["packages/render-ffmpeg/src/index.ts"],
      "@cadence/db": ["packages/db/src/index.ts"],
      "@cadence/db/queries": ["packages/db/src/queries.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "apps/**"]
}
