# Cadence environment — copy to `.env` and fill in. NEVER commit `.env`.

# --- Core ---
NODE_ENV=development

# --- Database (Postgres in Docker; free) ---
# These POSTGRES_* seed the `db` container (docker-compose) on first boot.
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence
POSTGRES_PORT=5432
# App connection string.
#   - local host tools (migrate, `npm run verify`): use localhost.
#   - inside docker-compose the `web` service overrides host to `db` (see compose).
DATABASE_URL=postgresql://cadence:cadence@localhost:5432/cadence

# --- Auth (local dev auth; free) ---
# Secret used to HMAC-sign the dev session cookie. CHANGE THIS; keep it out of git.
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-change-me-please-0000000000000000000000000000000000000000

# --- Director (AI brain) ---
# stub  = deterministic offline Director (default, free, no key)
# claude = real Claude via Anthropic API (METERED — money gate; requires key)
DIRECTOR_MODE=stub
# Only used when DIRECTOR_MODE=claude. Leave blank until the money gate is approved.
ANTHROPIC_API_KEY=

# --- Understanding: local Whisper (local, free) ---
# Real transcription uses a local Whisper CLI + ffmpeg (for audio extraction).
# When neither is present, /api/transcribe gracefully falls back to the offline
# StubTranscriber — nothing to configure to run the app.
# WHISPER_MODEL: model name for whisper/faster-whisper (tiny|base|small|medium|large),
# or a ggml model file PATH for whisper.cpp. Default: base.
WHISPER_MODEL=base
# Optional: force a custom command instead of auto-detecting whisper/whisper-cpp/
# faster-whisper on PATH. Tokens: {input} {model} {output_dir} {output}. The command
# must emit Whisper JSON (to stdout or a *.json in {output_dir}). Example:
# WHISPER_CMD=whisper {input} --model {model} --output_format json --output_dir {output_dir} --word_timestamps True
WHISPER_CMD=
# Optional: path to an ffmpeg binary (else "ffmpeg" on PATH). Shared with export.
# FFMPEG_PATH=

# --- Media storage (uploads → export/transcribe trust root) ---
# Where /api/upload writes media that the ffmpeg export and Whisper read back.
# Must persist between the (separate) upload and export requests. Default:
# `~/.cadence/uploads` locally/Docker (a stable dir that the OS never reaps),
# `os.tmpdir()/cadence-uploads` on serverless (VERCEL/Lambda, the only writable path).
# Docker: point this at a MOUNTED VOLUME so uploads survive container recreation.
# CADENCE_MEDIA_DIR=/data/cadence-uploads
#
# Vercel (serverless) has NO shared disk between the upload and export requests, so
# local storage can't work there. Enable Vercel Blob instead: Vercel dashboard →
# Storage → Create → Blob, then connect it to the project. Vercel injects
# BLOB_READ_WRITE_TOKEN automatically; when it is present, uploads go to Blob and the
# export downloads from it. Nothing to set by hand locally.
# BLOB_READ_WRITE_TOKEN=
#
# --- Export mode (client-side render — free, no server limits) ---
# NEXT_PUBLIC_EXPORT_MODE=client renders the .mp4 IN THE BROWSER via ffmpeg.wasm:
# media never leaves the device, so there is NO upload, NO Blob, and none of Vercel's
# serverless disk/size/time limits apply. Recommended for Vercel/free. Unset (or
# "server") keeps the server ffmpeg path (best for local/Docker with native ffmpeg).
# NEXT_PUBLIC_ var: set it in Vercel and redeploy for it to take effect.
# NEXT_PUBLIC_EXPORT_MODE=client

# --- Enhance: faithful upscale provider (money-gated beyond "free") ---
# free = no-AI lanczos+unsharp (default, faithful, never changes faces).
# local|api|cli = pluggable providers (Real-ESRGAN / paid API / any CLI). Money-gate.
ENHANCE_PROVIDER=free

# --- TTS: AI voice-over provider (money-gated) ---
# none = no synthesizer (default; generate_voiceover fails gracefully). Use the free
#        mic recorder instead. cli|api = wire a provider to enable AI voice-over.
TTS_PROVIDER=none
# TTS_CLI_COMMAND=
# TTS_API_URL=
# TTS_API_KEY=
