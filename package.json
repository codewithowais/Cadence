{
  "name": "cadence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cadence — a prompt-native, mass-market, enterprise-scale video editor. Edits-as-code.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "tsx scripts/verify.ts",
    "evals": "tsx scripts/evals.ts",
    "test:unit": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "npm run test:e2e --workspace @cadence/web",
    "test:e2e:install": "npm run test:e2e:install --workspace @cadence/web"
  },
  "devDependencies": {
    "@fontsource/abril-fatface": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/bangers": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lobster": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/pacifico": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/raleway": "5.3.0",
    "@fontsource/righteous": "5.3.0",
    "@fontsource/roboto-slab": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@types/node": "22.20.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
