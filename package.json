{
  "name": "cadence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cadence — a prompt-native, mass-market, enterprise-scale video editor. Edits-as-code.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "tsx scripts/verify.ts",
    "evals": "tsx scripts/evals.ts",
    "test:unit": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "npm run test:e2e --workspace @cadence/web",
    "test:e2e:install": "npm run test:e2e:install --workspace @cadence/web"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
